# ===================
# VidkNot 环境配置
# ===================
# 复制此文件为 .env 并填入实际值

# ===== 必填 =====
# SiliconFlow API Key（转录用）
# 注册地址: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=

# LLM API Key（生成笔记用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible 通用 LLM 接入（MiniMax / DeepSeek / 豆包 等）
# 若同时设置 LLM_API_KEY 和 OPENAI_API_KEY，两者各自独立生效
LLM_API_KEY=
LLM_BASE_URL=
VIDKNOT_LLM_MODEL=

# 共享 credential 文件路径（多 agent 宿主环境用）
# 例: VIDKNOT_ENV_FILE=~/.hermes/.env，其中通用 OPENAI_* 键会被自动剥离
VIDKNOT_ENV_FILE=

# ===== 语雀（可选）=====
# 注册地址: https://www.yuque.com
YUQUE_TOKEN=
YUQUE_LOGIN=

# ===== 飞书（可选）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=

# ===== Obsidian（可选）=====
OBSIDIAN_VAULT_PATH=./obsidian-vault

# ===== Notion（可选）=====
# 注册地址: https://www.notion.so/
# 创建集成: https://www.notion.so/my-integrations
NOTION_TOKEN=
NOTION_PAGE_ID=

# ===== 抖音（可选）=====
# 遇到登录态内容、短链解析失败或风控时配置
VIDKNOT_DOUYIN_COOKIE_FILE=
TIKHUB_API_KEY=
