# ===================
# VidkNot 环境配置
# ===================
# 复制此文件为 .env 并填入实际值

# ===== 必填 =====
# SiliconFlow API Key（转录用）
# 注册地址: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=

# LLM API Key（生成笔记用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible 通用 LLM 接入（MiniMax / DeepSeek / 豆包 等）
# 若同时设置 LLM_API_KEY 和 OPENAI_API_KEY，两者各自独立生效
LLM_API_KEY=
LLM_BASE_URL=
VIDKNOT_LLM_MODEL=

# 共享 credential 文件路径（多 agent 宿主环境用）
# 例: VIDKNOT_ENV_FILE=~/.hermes/.env，其中通用 OPENAI_* 键会被自动剥离
VIDKNOT_ENV_FILE=

# ===== 语雀（可选）=====
# 注册地址: https://www.yuque.com
YUQUE_TOKEN=
YUQUE_LOGIN=

# ===== 飞书（可选）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=

# ===== Obsidian（可选）=====
OBSIDIAN_VAULT_PATH=./obsidian-vault

# ===== Notion（可选）=====
# 注册地址: https://www.notion.so/
# 创建集成: https://www.notion.so/my-integrations
NOTION_TOKEN=
NOTION_PAGE_ID=

# ===== 抖音（可选）=====
# 遇到登录态内容、短链解析失败或风控时配置
VIDKNOT_DOUYIN_COOKIE_FILE=
TIKHUB_API_KEY=

# ===== 双 ASR 校正 / 搜证后端（可选，不绑定任何厂商）=====
# 仅在用「一键成稿」模式且开启双 ASR 校正时才生效。
# 用「两段式」模式（--material / video_material）时，搜证与校正由智能体
# 自己完成，下面这些开关一律不生效。
#
# 校正后端: auto(默认) | provider | mmx | none
#   auto    = 按 provider -> mmx -> 跳过 自动选第一个可用的
#   provider= 用 providers.default_provider 配的 OpenAI 兼容端点
#   mmx     = 用 MiniMax 官方 CLI（mmx text chat）
#   none    = 不做校正
VIDKNOT_CORRECTION_BACKEND=auto

# 搜证后端: mmx | none（mmx 未安装时自动跳过搜证，不报错）
VIDKNOT_SEARCH_BACKEND=mmx

# mmx 后端使用的模型（留空则用 mmx CLI 自身默认模型）
VIDKNOT_CORRECTION_MODEL=
