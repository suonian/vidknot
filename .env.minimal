# ===============================
# VidkNot 最小配置（单 key）
# ===============================
# 这是 VidkNot 的最小配置模板 —— **只需要 1 个 API key**：
#   - SILICONFLOW_API_KEY（用于 ASR 语音转文字）
#
# 其他 LLM/存储可选。如需生成结构化笔记（不只是转录文本），
# 还需要配置 LLM_API_KEY + LLM_BASE_URL + VIDKNOT_LLM_MODEL。
# 详见 .env.example（完整版）和 SKILL.md / docs/CONFIG.md。

# ===== 必填: ASR（语音转文字）=====
# SiliconFlow（推荐，国内访问快）
# 注册: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-your-key-here

# ===== 可选: LLM（结构化笔记生成）=====
# 任何 OpenAI 兼容服务（OpenAI / GLM / Qwen / DeepSeek 等）
# 如不设置，--raw 模式仍可用（只输出转录文本，不生成笔记）
# LLM_API_KEY=sk-your-llm-key
# LLM_BASE_URL=https://api.openai.com/v1
# VIDKNOT_LLM_MODEL=gpt-4o-mini

# ===== 可选: 存储目标（默认 destination=none，只输出）=====
# Obsidian（本地 vault）
# OBSIDIAN_VAULT_PATH=/path/to/obsidian/vault
#
# 飞书
# FEISHU_APP_ID=cli_xxxx
# FEISHU_APP_SECRET=your-secret
#
# Notion
# NOTION_TOKEN=secret_xxxx
# NOTION_PAGE_ID=xxxx
#
# 语雀
# YUQUE_TOKEN=xxxx
# YUQUE_LOGIN=your-username

# ===== 可选: 抖音 cookie（如果下载抖音视频需要）=====
# VIDKNOT_DOUYIN_COOKIE_FILE=/path/to/douyin-cookies.txt

# ===== 可选: 输出语言（默认 auto 自动检测）=====
# VIDKNOT_LANGUAGE=zh
